{
  "name": "toolbox-extension",
  "displayName": "Toolbox",
  "description": "Session-based terminal, database, and scripting toolbox for VS Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "toolbox",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "toolbox.open",
        "title": "Toolbox: Open"
      },
      {
        "command": "toolbox.newSession",
        "title": "Toolbox: New Session"
      },
      {
        "command": "toolbox.showSessions",
        "title": "Toolbox: Show Sessions"
      },
      {
        "command": "toolbox.showDiagnostics",
        "title": "Toolbox: Show Diagnostics"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "^5.4.0"
  }
}
